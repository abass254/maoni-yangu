# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=https://your-app.vercel.app

# JWT signing key (use a long random string in production)
SURVEY_SECRET_KEY=change-me-to-a-long-random-string

# MySQL (preferred) or omit to use local SQLite
# Example: mysql://user:password@host:3306/survey
# SQLAlchemy will use mysql+pymysql:// automatically
DATABASE_URL=mysql://survey_user:CHANGE_ME@db.tiberbu.com:3306/survey
